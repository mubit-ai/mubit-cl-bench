{
  "title": "Token Efficiency: Mubit Memory vs Full Context Replay",
  "description": "Generalized model of cumulative input tokens for an agent processing N sequential queries. Without memory, each query re-sends all prior conversation history (quadratic growth). With Mubit, each query retrieves a fixed-size block of relevant lessons (linear growth).",
  "assumptions": {
    "system_prompt_tokens": 2000,
    "avg_query_tokens": 500,
    "avg_response_tokens": 1000,
    "mubit_retrieval_tokens": 1500,
    "note": "Based on empirical data from BSM (97.3% savings), Database (92.1%), and Tencent CL-bench (19.2%) benchmarks."
